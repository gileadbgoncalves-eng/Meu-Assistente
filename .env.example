# ==============================================================================
# CONFIGURAÇÃO DO MEU ASSISTENTE - AMBIENTE & SEGREDOS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API do Gemini (Google GenAI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional
# ------------------------------------------------------------------------------
# Desenvolvimento Local / Testes (zero configuração):
DATABASE_URL=sqlite+aiosqlite:///./meu_assistente.db

# Produção (PostgreSQL com driver asyncpg):
# DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/meu_assistente
# ou Supabase / Neon:
# DATABASE_URL=postgresql+asyncpg://postgres:senha@db.exemplo.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Configurações de Fuso Horário e Idioma
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LOCALE=pt_BR

# ------------------------------------------------------------------------------
# 4. Servidor FastAPI / Webhook
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. WhatsApp Cloud API (Meta for Developers)
# ------------------------------------------------------------------------------
# Token definido no painel da Meta para o handshake inicial de verificação (GET /webhook)
WHATSAPP_VERIFY_TOKEN=meu_token_secreto_de_verificacao

# Token de acesso permanente ou temporário do sistema (Graph API)
WHATSAPP_ACCESS_TOKEN=EAAG...

# Identificador do número de telefone fornecido pela Meta (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Chave secreta do aplicativo da Meta para validação HMAC da assinatura X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Versão da Graph API
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 6. Integrações com Google Agenda & Google Maps Platform
# ------------------------------------------------------------------------------
# Caminho para arquivo de credenciais de Service Account ou OAuth do Google Cloud
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json

# Chave de API da Google Maps Platform (Distance Matrix API & Places API)
GOOGLE_MAPS_API_KEY=AIzaSy...
